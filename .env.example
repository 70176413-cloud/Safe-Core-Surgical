# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMTP Mail Server Configuration (Optional - Safe Core Surgical email system defaults to Ethereal Testing fallbacks if not set)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sales@safecoresurgical.com"
SMTP_PASS="your_secure_app_password"
SMTP_SECURE="false"
SMTP_FROM_EMAIL="Safe Core Catalog <noreply@safecoresurgical.com>"
